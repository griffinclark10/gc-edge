---
import Fill from './Fill.astro';
import { worldline } from '../data/home';

// Event dots sit on the worldline curve below "now" (one per past role, E₅ → E₁).
const pastDots = [
  [178, 195],
  [165, 262],
  [184, 330],
  [184, 398],
  [140, 466],
];
---

<div class="worldline">
  <div class="diagram" aria-hidden="true">
    <svg viewBox="0 0 360 520">
      <path d="M20 10 L340 10 L180 120 Z" fill="#FFD23F" opacity="0.2"></path>
      <path d="M180 120 L20 10 M180 120 L340 10" stroke="#FFD23F" stroke-width="2"></path>
      <text
        x="180"
        y="44"
        fill="#F2F5FF"
        font-family="IBM Plex Mono"
        font-size="13"
        text-anchor="middle"
      >
        future light cone
      </text>
      <text
        x="180"
        y="62"
        fill="#C9D4F5"
        font-family="IBM Plex Mono"
        font-size="11"
        text-anchor="middle"
      >
        everything reachable from here
      </text>
      <path
        d="M180 120 C 200 180, 150 230, 170 290 S 210 380, 160 430 S 170 500, 180 515"
        fill="none"
        stroke="#F2F5FF"
        stroke-width="3"
      ></path>
      <g fill="#F2F5FF">
        {pastDots.map(([cx, cy]) => (
          <circle cx={cx} cy={cy} r="6" />
        ))}
      </g>
      <circle cx="180" cy="120" r="8" fill="#FFD23F" stroke="#F2F5FF" stroke-width="2"></circle>
      <path d="M30 515 V20" stroke="#9FB2E8" stroke-width="1.5"></path>
      <text x="38" y="500" fill="#9FB2E8" font-family="IBM Plex Mono" font-size="11">
        t
      </text>
      <text
        x="196"
        y="125"
        fill="#F2F5FF"
        font-family="IBM Plex Mono"
        font-size="12"
        font-weight="600"
      >
        now
      </text>
    </svg>
  </div>

  <ol class="events">
    {worldline.map((e) => (
      <li class:list={{ current: e.current }}>
        <span class="marker" aria-hidden="true" />
        <p class="when mono">
          {e.from} → {e.to} · event {e.event}
        </p>
        <h3>
          <Fill text={e.title} />
        </h3>
        <p class="copy">
          <Fill text={e.copy} />
        </p>
      </li>
    ))}
  </ol>
</div>

<style>
  .worldline {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }

  .diagram {
    flex: 1 1 280px;
    min-width: 0;
    max-width: 400px;
    padding: 16px;
    border: 2px solid var(--bp-ink);
    background: var(--bp-deep);
  }

  .events {
    flex: 999 1 480px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 3px solid var(--bp-ink);
  }

  li {
    position: relative;
    padding: 0 0 32px 28px;
  }

  li:last-child {
    padding-bottom: 0;
  }

  /* markers centred on the 3px rule */
  .marker {
    position: absolute;
    left: -8.5px;
    top: 5px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bp-ink);
  }

  .current .marker {
    left: -9.5px;
    top: 4px;
    width: 16px;
    height: 16px;
    border-radius: 0;
    background: var(--accent);
    border: 2px solid var(--bp-deep);
  }

  .when {
    margin: 0;
    font-size: 13px;
    color: var(--bp-muted);
  }

  h3 {
    margin: 4px 0 6px;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
  }

  .copy {
    margin: 0;
    max-width: 620px;
    font-size: 16px;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .diagram {
      max-width: 320px;
    }

    h3 {
      font-size: 22px;
    }
  }
</style>
