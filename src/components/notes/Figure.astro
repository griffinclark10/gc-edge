---
// §5.4 note figure: white card, 2px blue border, mono "FIG. n ·" caption. For MDX.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  n: number;
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { n, src, alt, caption } = Astro.props;
const widths = [...new Set([400, 800, 1200, src.width].filter((w) => w <= src.width))];
---

<figure class="note-figure">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(min-width: 760px) 700px, 100vw"
    style={{ maxWidth: `min(100%, ${Math.round(src.width * 1.5)}px)` }}
  />
  <figcaption class="mono">
    FIG. {n} · {caption}
  </figcaption>
</figure>

<style>
  .note-figure {
    margin: 32px 0;
    padding: 12px;
    border: 2px solid var(--pp-ink);
    background: var(--pp-card);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }

  figcaption {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--pp-muted);
  }
</style>
