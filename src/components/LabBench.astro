---
import Fill from './Fill.astro';
import { benchParagraphs, instruments } from '../data/home';
---

<div class="bench">
  <div class="text">
    <h2 id="bench-title">On the lab bench</h2>
    {benchParagraphs.map((paragraph) => (
      <p>
        <Fill text={paragraph} />
      </p>
    ))}
  </div>
  <div class="instruments">
    {instruments.map((group) => (
      <div class:list={['instrument', { highlight: group.highlight }]}>
        <p class="label mono">{group.label}</p>
        <ul class="mono">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .bench {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }

  .text {
    flex: 999 1 480px;
    min-width: 0;
  }

  h2 {
    margin: 0 0 24px;
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .text p {
    margin: 0 0 18px;
    max-width: 640px;
    font-size: 20px;
    line-height: 1.55;
  }

  .instruments {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .instrument {
    padding: 20px;
    border: 2px solid var(--bp-ink);
  }

  .instrument.highlight {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bp-deep);
  }

  .label {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--bp-muted);
  }

  .highlight .label {
    color: var(--bp-deep);
    font-weight: 600;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.8;
  }

  li {
    display: inline;
  }

  li:not(:last-child)::after {
    content: ' · ';
  }
</style>
