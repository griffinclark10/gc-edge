---
import Fill from './Fill.astro';
import { specSheet } from '../data/home';
---

<aside class="spec" aria-label="Spec sheet">
  <p class="title mono">datasheet · rev 2026.10</p>
  <dl class="mono">
    {specSheet.map(([key, value]) => (
      <>
        <dt>{key}</dt>
        <dd>
          <Fill text={value} />
        </dd>
      </>
    ))}
  </dl>
  <p class="warn mono">⚠ do not operate near unlabelled ground truth</p>
</aside>

<style>
  .spec {
    flex: 0 1 380px;
    min-width: 0;
    padding: 24px 24px 20px;
    background: var(--bp-deep);
    color: var(--bp-ink);
    border: 2px solid var(--bp-ink);
    transform: rotate(1.5deg);
    box-shadow: 8px 8px 0 var(--accent);
  }

  .title {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bp-muted-2);
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 12px;
    font-size: 14px;
  }

  dt {
    color: var(--bp-muted-2);
  }

  dd {
    margin: 0;
  }

  .warn {
    margin: 20px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--bp-rule);
    font-size: 12px;
    color: var(--bp-muted-2);
  }

  @media (max-width: 640px) {
    .spec {
      max-width: 480px;
      transform: none;
    }
  }
</style>
